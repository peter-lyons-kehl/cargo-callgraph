[package]
name = "cargo-callgraph"
version = "0.1.0"
edition = "2024"
license = "AGPL-3.0-or-later"
authors = ["Sienna Meridian Satterwhite <sienna@sunbeam.pt>"]
description = "Generate callgraphs for Rust workspaces using rust-analyzer"
keywords = ["cargo-subcommand", "callgraph", "rust-analyzer", "static-analysis"]
categories = ["development-tools::cargo-plugins", "development-tools::debugging"]
repository = "https://github.com/sienna/callgraph-rs"
readme = "README.md"

[dependencies]
# rust-analyzer internals (published to crates.io as ra_ap_*)
# Version pinning note: these crates are tightly coupled and released in lockstep.
# We let Cargo resolve a compatible set, then pin.
ra_ap_load-cargo = "=0.0.334"
ra_ap_project_model = "=0.0.334"
ra_ap_ide = "=0.0.334"
ra_ap_ide_db = "=0.0.334"
ra_ap_hir = "=0.0.334"
ra_ap_base_db = "=0.0.334"
ra_ap_vfs = "=0.0.334"
ra_ap_syntax = "=0.0.334"
ra_ap_paths = "=0.0.334"

# graph + serialization
petgraph = "0.6"
serde = { version = "1", features = ["derive"] }
serde_json = "1"

# CLI + errors
clap = { version = "4", features = ["derive"] }
anyhow = "1"

# utilities
indexmap = "2"

# MCP server
rmcp = { version = "0.16", features = ["server", "macros", "transport-io"] }
tokio = { version = "1", features = ["rt-multi-thread", "macros", "io-std"] }
schemars = "1.0"

[[bin]]
name = "cargo-callgraph"
path = "src/main.rs"
